# Telegram Bot Token (from @BotFather)
BOT_TOKEN=
BOT_USERNAME=your_bot_username

# Optional GitHub token for higher API rate limits (never shown in bot replies)
GITHUB_TOKEN=

# Optional external short-link service. Enabled only when all three are set and the API is HTTPS.
# The bot sends POST {"url": "<local /s/ link>", "domain": "<SHORTLINK_DOMAIN>"} with
# "Authorization: Bearer <SHORTLINK_TOKEN>" and uses data.short_url from the JSON response.
# Any failure falls back to the local /s/ link. Never commit the real token.
SHORTLINK_API_URL=
SHORTLINK_TOKEN=
SHORTLINK_DOMAIN=

# Initial Telegram user allowlist. Empty enables public use; explicit revocations still apply.
ALLOWED_USER_IDS=

# Optional separate administrator IDs for /auth management in private chat.
# When unset, defaults to ALLOWED_USER_IDS. An explicit empty value disables /auth.
# Recommended: only include maintainers here, not every authorized user.
# ADMIN_USER_IDS=123456789

# Public URL for subscription/short-link endpoints. Use HTTPS when exposed beyond localhost.
PUBLIC_BASE_URL=http://127.0.0.1:8787

# HTTP server
HTTP_HOST=127.0.0.1
HTTP_PORT=8787

# Data directory (optional, defaults to ./data)
DATA_DIR=/opt/subs-bot/data
DB_PATH=/opt/subs-bot/data/subs.db

# Upload/import limits
MAX_DOCUMENT_BYTES=10485760
MAX_IMPORTED_NODES=500
MAX_IMPORTED_SUBSCRIPTIONS=20

# Concurrency & scheduled background auto-refresh / alert thresholds
UPDATE_CONCURRENCY=8
AUTO_REFRESH_HOURS=6
ALERT_EXPIRE_DAYS=3
ALERT_TRAFFIC_GB=5
