# Telegram Bot Token (from @BotFather)
BOT_TOKEN=
BOT_USERNAME=your_bot_username

# Optional GitHub token for higher API rate limits (never shown in bot replies)
GITHUB_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot. Required for production.
ALLOWED_USER_IDS=

# Public URL for subscription/short-link endpoints (http://YOUR_IP:8787)
PUBLIC_BASE_URL=http://127.0.0.1:8787

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8787

# Data directory (optional, defaults to ./data)
DATA_DIR=/opt/subs-bot/data
DB_PATH=/opt/subs-bot/data/subs.db

# Upload/import limits
MAX_DOCUMENT_BYTES=10485760
MAX_IMPORTED_NODES=500
MAX_IMPORTED_SUBSCRIPTIONS=20
